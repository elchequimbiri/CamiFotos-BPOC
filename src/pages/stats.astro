---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStats } from '../lib/stats';

const stats = getStats();

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}
---

<BaseLayout title="Access Statistics - Cami Fotos">
  <div class="stats-page">
    <div class="stats-header">
      <h1>Access Statistics</h1>
      <p>{stats.length} total events</p>
    </div>

    <div class="stats-table-wrapper">
      <table class="stats-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>User</th>
            <th>Action</th>
            <th>Target</th>
          </tr>
        </thead>
        <tbody>
          {stats.slice(0, 500).map((stat) => (
            <tr>
              <td class="date-cell">{formatDate(stat.date)}</td>
              <td><span class={`role-badge role-${stat.user}`}>{stat.user}</span></td>
              <td>{stat.action.replace(/_/g, ' ')}</td>
              <td class="target-cell">{stat.target}</td>
            </tr>
          ))}
          {stats.length === 0 && (
            <tr>
              <td colspan="4" class="empty-cell">No access data yet.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>

<style>
  .stats-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .stats-header {
    margin-bottom: 2rem;
  }

  .stats-header h1 {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
  }

  .stats-header p {
    font-size: 0.85rem;
    opacity: 0.4;
  }

  .stats-table-wrapper {
    overflow-x: auto;
  }

  .stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .stats-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 500;
    opacity: 0.5;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stats-table td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .stats-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .date-cell {
    white-space: nowrap;
    opacity: 0.6;
  }

  .target-cell {
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .role-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
    font-weight: 500;
  }

  .role-family {
    background: rgba(46, 204, 113, 0.15);
    color: #2ecc71;
  }

  .role-admin {
    background: rgba(52, 152, 219, 0.15);
    color: #3498db;
  }

  .empty-cell {
    text-align: center;
    opacity: 0.4;
    padding: 3rem;
  }

  @media (max-width: 640px) {
    .stats-page {
      padding: 1rem;
    }

    .stats-table {
      font-size: 0.8rem;
    }

    .stats-table th,
    .stats-table td {
      padding: 0.5rem 0.6rem;
    }
  }
</style>
