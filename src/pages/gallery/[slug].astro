---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGalleryImages, galleryExists } from '../../lib/galleries';
import { logAccess } from '../../lib/stats';

const session = Astro.locals.session;
const { slug } = Astro.params;

if (!slug || !galleryExists(slug)) {
  return Astro.redirect('/gallery');
}

const images = getGalleryImages(slug);
const name = slug.replace(/^\d+/, '').replace(/galeria$/i, '').trim() || slug;

logAccess(session?.role || 'unknown', 'view_gallery', slug);
---

<BaseLayout title={`${name} - Cami Fotos`}>
  <div class="gallery-page">
    <div class="gallery-header">
      <a href="/gallery" class="back-link">&larr; Back</a>
      <h1>{name}</h1>
      <span class="photo-count">{images.length} photos</span>
    </div>
    <div class="photo-grid">
      {images.map((src, index) => (
        <div class="photo-item" data-index={index}>
          <img
            src={src}
            alt={`${name} ${index + 1}`}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <div id="lightbox" class="lightbox hidden">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox-prev" aria-label="Previous">&lsaquo;</button>
    <button class="lightbox-next" aria-label="Next">&rsaquo;</button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-counter">
      <span id="lightbox-index">1</span> / <span id="lightbox-total">{images.length}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .gallery-page {
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
  }

  .gallery-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.85rem;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 1;
  }

  .gallery-header h1 {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .photo-count {
    font-size: 0.8rem;
    opacity: 0.4;
    margin-left: auto;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 6px;
  }

  .photo-item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 3px;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s, opacity 0.3s;
  }

  .photo-item:hover img {
    transform: scale(1.03);
    opacity: 0.85;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.2s;
  }

  .lightbox.hidden {
    display: none;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s;
    z-index: 10;
    padding: 0.5rem;
    line-height: 1;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-prev, .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #fff;
    font-size: 3rem;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.2s;
    padding: 1rem;
    z-index: 10;
  }

  .lightbox-prev {
    left: 1rem;
  }

  .lightbox-next {
    right: 1rem;
  }

  .lightbox-prev:hover, .lightbox-next:hover {
    opacity: 1;
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .gallery-page {
      padding: 1rem;
    }

    .photo-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 4px;
    }

    .lightbox-prev, .lightbox-next {
      font-size: 2rem;
      padding: 0.5rem;
    }
  }
</style>

<script define:images={images}>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxIndex = document.getElementById('lightbox-index');
  const photos = document.querySelectorAll('.photo-item');
  let currentIndex = 0;

  const allImages = images;

  function openLightbox(index: number) {
    currentIndex = index;
    lightboxImg.src = allImages[index];
    lightboxImg.alt = `Photo ${index + 1}`;
    if (lightboxIndex) lightboxIndex.textContent = String(index + 1);
    lightbox?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function navigate(direction: number) {
    currentIndex = (currentIndex + direction + allImages.length) % allImages.length;
    lightboxImg.src = allImages[currentIndex];
    lightboxImg.alt = `Photo ${currentIndex + 1}`;
    if (lightboxIndex) lightboxIndex.textContent = String(currentIndex + 1);
  }

  photos.forEach((photo, index) => {
    photo.addEventListener('click', () => openLightbox(index));
  });

  document.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
  document.querySelector('.lightbox-prev')?.addEventListener('click', () => navigate(-1));
  document.querySelector('.lightbox-next')?.addEventListener('click', () => navigate(1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-content')) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });
</script>
